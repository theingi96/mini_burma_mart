<h1>MiniBurma Mart</h1>
<p>Burmese Grocery Store in Japan</p>

<% if user_signed_in? %>
  <p><%= link_to "Add New Product", new_product_path %></p>
<% else %>
  <p><%= link_to "Login", new_user_session_path %> to add products</p>
<% end %>

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1>Bring Myanmar's Taste to Your Table</h1>
      <p>
        Discover Burmese groceries, snacks, spices, and daily essentials
        delivered for the Myanmar community in Japan.
      </p>

      <div class="hero-actions">
        <%= link_to "Shop Now", "#product-list", class: "primary-btn" %>

        <% if user_signed_in? %>
          <%= link_to "Add New Product", new_product_path, class: "secondary-btn" %>
        <% else %>
          <%= link_to "Create Account", new_user_registration_path, class: "secondary-btn" %>
        <% end %>
      </div>
    </div>

    <div class="hero-card">
      <h3>Popular Burmese Items</h3>
      <ul>
        <li>Laphet</li>
        <li>Mohinga Mix</li>
        <li>Shan Noodles</li>
        <li>Pickled Tea Snacks</li>
      </ul>
    </div>
  </div>
</section>

<section class="products-section container" id="product-list">
  <div class="section-heading">
    <h2>Featured Products</h2>
    <p>Carefully selected Burmese items available in Japan.</p>
  </div>

  <div class="product-grid">
    <% @products.each do |product| %>
      <div class="product-card">

        <div class="product-image-wrap">
          <% if product.image.attached? %>
            <%= image_tag product.image, class: "product-image" %>
          <% else %>
            <div class="no-image">No Image</div>
          <% end %>

          <span class="category-badge">
            <%= product.category.name %>
          </span>

          <% if product.stock > 0 %>
            <span class="stock-badge in-stock">In Stock</span>
          <% else %>
            <span class="stock-badge out-stock">Sold Out</span>
          <% end %>
        </div>

        <div class="product-card-body">
          <h3 class="product-name">
            <%= link_to product.name, product_path(product), class: "product-link" %>
          </h3>

          <p class="product-description">
            <%= truncate(product.description, length: 70) %>
          </p>

          <div class="product-meta">
            <span class="price">¥<%= product.price %></span>
            <span class="stock">Stock: <%= product.stock %></span>
          </div>

          <div class="card-actions">
            <%= link_to "View Details", product_path(product), class: "small-btn" %>

            <% if user_signed_in? %>
              <%= link_to "Edit", edit_product_path(product), class: "small-btn light-btn" %>

              <%= link_to "Delete",
                    product_path(product),
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                    class: "small-btn danger-btn" %>
            <% end %>
          </div>
        </div>

      </div>
    <% end %>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <p>© MiniBurma Mart — Burmese Grocery Store in Japan</p>
  </div>
</footer>
<h1>Add New Product</h1>

<% if @product.errors.any? %>
  <div style="color: red;">
    <h2><%= pluralize(@product.errors.count, "error") %> prohibited this product from being saved:</h2>
    <ul>
      <% @product.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @product, local: true do |f| %>
  <div>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :price %><br>
    <%= f.number_field :price %>
  </div>

  <div>
    <%= f.label :stock %><br>
    <%= f.number_field :stock %>
  </div>

  <div>
    <%= f.label :category_id, "Category" %><br>
    <%= f.collection_select :category_id, Category.all, :id, :name, prompt: "Select category" %>
  </div>

  <div>
    <%= f.label :is_active %><br>
    <%= f.select :is_active, [["Active", true], ["Inactive", false]] %>
  </div>

  <div>
    <%= f.label :image %><br>
    <%= f.file_field :image %>
  </div>

  <div style="margin-top: 12px;">
    <%= f.submit "Create Product" %>
  </div>
<% end %>

<br>
<%= link_to "Back to products", root_path %>